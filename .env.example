# Copy this file to .env and fill in the values.

# --- Claude (the companion's brain) ---------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (voice: speech-to-text + text-to-speech) ----------------------
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=sk-...

# --- Database (any Postgres; use Neon's POOLED url on serverless) ----------
# Local example:   postgres://user:pass@localhost:5432/act
# Neon (pooled):   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/act?sslmode=require
DATABASE_URL=postgres://localhost:5432/act

# --- Auth (single private account) ----------------------------------------
# Generate the hash with:  npm run hash-pass -- "your secret passphrase"
APP_PASSPHRASE_HASH=
# Any long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Web Push notifications (gentle reminders) ----------------------------
# Generate a key pair with:  npm run gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional model overrides ---------------------------------------------
# MODEL=claude-opus-4-7        # set to claude-sonnet-4-6 for faster, cheaper replies
# THINKING=adaptive            # set to "off" for the snappiest responses
# EFFORT=low                   # low | medium | high
# STT_MODEL=gpt-4o-transcribe  # or whisper-1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# PORT=3000
